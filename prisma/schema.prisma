generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum ReadingStatus {
  WAITING
  READING
  COMPLETED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  defaultAppearance Json?
  passwordHash String
  nickname     String
  bio          String @default("") @db.VarChar(300)
  profilePublic Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships RoomMember[]
  sessions Session[]
  heldRooms Room[] @relation("BookHolder")
}

model RoomCover {
  roomId String @id @db.Uuid
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hash   String
  image  Bytes
}

model Room {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  bookTitle   String
  cover       RoomCover?
  visibility  RoomVisibility @default(PRIVATE)
  maxMembers  Int            @default(4)
  version     Int            @default(0)
  hostEpoch   BigInt         @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     RoomMember[]
  prototypeChatMessages PrototypeChatMessage[]
  exchangeCode String? @unique
  exchangeOwnerId String? @db.Uuid
  author String @default("")
  theme String @default("mint")
  startedAt DateTime?
  completedAt DateTime?
  bookHolderId String? @db.Uuid
  bookHolder User? @relation("BookHolder", fields: [bookHolderId], references: [id], onDelete: Restrict)
  invites RoomInvite[]
  transfers BookTransfer[]
  messages ChatMessage[]
  recordOperations RecordOperation[]

  @@index([visibility, createdAt])
}

model RoomMember {
  roomId          String        @db.Uuid
  userId          String        @db.Uuid
  role            MemberRole    @default(MEMBER)
  readingOrder    Int
  readingStatus   ReadingStatus @default(WAITING)
  readingStartedAt DateTime?
  readingCompletedAt DateTime?
  displayName String?
  appearance Json?
  rating Float?
  review String @default("")
  quote String @default("")
  joinedAt        DateTime      @default(now())
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
  @@unique([roomId, readingOrder])
  @@index([userId])
}

model PrototypeChatMessage {
  id         String   @id @db.Uuid
  roomId     String   @db.Uuid
  sequence   BigInt   @unique @default(autoincrement())
  senderSlot Int
  text       String
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, sequence])
}
model Session {
  tokenHash String @id
  userId String @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([userId])
}
model RoomInvite {
  id String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  maxUses Int @default(1)
  uses Int @default(0)
  revoked Boolean @default(false)
  createdAt DateTime @default(now())
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@index([roomId])
}
model BookTransfer {
  id String @id @db.Uuid
  roomId String @db.Uuid
  fromUserId String @db.Uuid
  toUserId String @db.Uuid
  version Int
  createdAt DateTime @default(now())
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
}
model ChatMessage {
  id String @id @db.Uuid
  roomId String @db.Uuid
  senderId String @db.Uuid
  sequence BigInt @unique @default(autoincrement())
  text String
  createdAt DateTime @default(now())
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@index([roomId, sequence])
}

model RecordOperation {
  id String @id @db.Uuid
  roomId String @db.Uuid
  authorId String @db.Uuid
  actorSlot Int
  sequence BigInt @unique @default(autoincrement())
  kind String
  slot Int
  page Int
  postId String? @db.Uuid
  replyId String? @db.Uuid
  digest String
  bytes Int
  createdAt DateTime @default(now())
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@index([roomId, sequence])
  @@index([roomId, slot, page])
}
