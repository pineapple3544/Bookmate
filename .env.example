# Local development only. Replace credentials for deployment.
POSTGRES_USER=bookmate
POSTGRES_PASSWORD=bookmate_local
POSTGRES_DB=bookmate
DATABASE_URL=postgresql://bookmate:bookmate_local@localhost:5432/bookmate
PORT=3000
HOST=0.0.0.0
WEB_ORIGINS=http://localhost:5173,http://localhost:5500
LOG_LEVEL=info

PROTOTYPE_CHAT_ENABLED=true

# Enable only behind HTTPS in deployment
COOKIE_SECURE=false

# Optional NAT traversal. Comma-separated stun:/turn:/turns: URLs.
RTC_STUN_URLS=
RTC_TURN_URLS=
# coturn use-auth-secret/static-auth-secret; never sent to browsers.
RTC_TURN_SECRET=
# Force TURN for deployment diagnostics only.
RTC_RELAY_ONLY=false
